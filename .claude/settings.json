{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/scripts/risk_hook.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(.claude/**)",
      "Edit(scripts/**)",
      "Edit(PLAYBOOK.md)",
      "Edit(RISK.md)"
    ]
  }
}
